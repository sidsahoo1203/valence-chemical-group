{
  "name": "valence-chemical-group",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm --prefix server run dev\" \"npm --prefix client run dev\"",
    "install:all": "npm install",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "db:generate": "drizzle-kit generate",
    "seed": "npm --workspace server run seed",
    "test:browser": "playwright test",
    "db:check": "npm --workspace server run db:check"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@testing-library/react": "^16.3.3",
    "concurrently": "^9.1.2",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.25.0",
    "jsdom": "^30.1.1"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "drizzle-orm": "^0.45.3",
    "jose": "^6.0.0",
    "lucide-react": "^0.468.0",
    "zod": "^3.24.2"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
